# Settings for scholar-crawler, read with --config scholar.toml
#
# Copy this file, edit it, and pass it with --config. Anything you also type as a flag
# wins over the file, and the file wins over the built-in defaults; --explain prints
# where every value in effect came from.
#
# Keys are the long flags without the leading dashes: --min-delay is min-delay (or
# min_delay). Tables like [pacing] are for your own organisation only — the crawler
# reads their contents exactly as if the keys stood at the top of the file.
#
# Modes stay on the command line: --doctor, --self-check, --rehearse-handoff,
# --show-state, --forget, --dry-run, --explain and --recipes are decisions about what
# the command does, not settings for how it behaves.

# What to crawl. A repeatable flag takes a list; passing -q on the command line
# replaces this list rather than adding to it.
query = [
  "graph attention networks",
  "graph transformer",
]
pages = 2

[filters]
year-from = 2020
review-only = false

[pacing]
# Slower than the default 4-11s: a persistent profile plus a calm rhythm is what keeps
# a long collection from being challenged.
min-delay = 8.0
max-delay = 20.0
cooldown-every = 5
cooldown-seconds = 120.0

[takeover]
# 0 waits indefinitely for a human, which is the right setting when you are at the desk.
handoff-timeout = 900.0
max-handoffs = 3

[browser]
profile = ".scholar-profile"
locale = "en-US"

[output]
out = "out/gnn.jsonl"
csv = "out/gnn.csv"
state = "out/state.json"
challenge-log = "out/challenges.jsonl"
